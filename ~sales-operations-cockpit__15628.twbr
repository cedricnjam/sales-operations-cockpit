      <aliases enabled='yes' />
      <column caption='Profit Margin' datatype='real' default-format='p0.0%' name='[Calculation_1073994057334784]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([profit]) / SUM([sales])' />
      </column>
      <column caption='Return Rate' datatype='real' default-format='p0.0%' name='[Calculation_1073994057596930]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [returned] = &apos;Yes&apos; THEN [order_id] END) / COUNTD([order_id])' />
      </column>
      <column caption='Shipping Delay Days' datatype='integer' name='[Calculation_1073994058162179]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [order_date], [ship_date])' />
      </column>
      <column caption='Customer Lifetime Sales' datatype='real' name='[Calculation_1073994058276868]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [customer_id] : SUM([sales]) }' />
      </column>
